#!/bin/bash
# Show/hide the working-memory scratchpad: a floating terminal running the
# omarchy-working-memory TUI, parked on its own Hyprland special workspace
# so toggling hides it instead of closing it (state, including whatever is
# unsaved in the buffer, is preserved between toggles).
#
# Bound to both the Super+N keybinding and the bar icon click, so both
# trigger the exact same show/hide behavior.
set -euo pipefail

APP_ID="omarchy-working-memory"
WORKSPACE="working-memory"

# Resolve through the symlink (this script is installed as a symlink into
# ~/.local/bin) to find the repo-provided foot config alongside it.
REPO_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
FOOT_CONFIG="$REPO_DIR/foot-scratchpad.ini"

is_running() {
  hyprctl clients -j | jq -e --arg c "$APP_ID" '.[] | select(.class == $c)' >/dev/null 2>&1
}

# True only once the window rule has actually parked it on the special
# workspace — not just once the window exists. There's a brief gap between
# the window mapping (is_running becomes true) and Hyprland applying the
# `workspace = special:... silent` rule; toggling before that gap closes
# would reveal the special workspace while it's still empty.
on_special_workspace() {
  hyprctl clients -j | jq -e --arg c "$APP_ID" --arg w "special:$WORKSPACE" \
    '.[] | select(.class == $c and .workspace.name == $w)' >/dev/null 2>&1
}

reveal() {
  # This system's Hyprland build (Omarchy's Lua-config fork) routes CLI
  # dispatches through `hyprctl eval` + hl.dispatch/hl.dsp.* rather than the
  # classic `hyprctl dispatch <name> <args>` form — that form is silently
  # rejected here (prints a Lua parse error but still exits 0).
  hyprctl eval "hl.dispatch(hl.dsp.workspace.toggle_special(\"$WORKSPACE\"))" >/dev/null
}

if is_running; then
  reveal
  exit 0
fi

# Launched via foot explicitly rather than the user's default terminal:
# Ghostty (this system's xdg-terminal-exec default) ignores --app-id
# entirely, which breaks the window-rule matching below. Foot honors it
# reliably and starts fast, which suits a single-purpose scratchpad well.
setsid foot --config="$FOOT_CONFIG" --app-id="$APP_ID" -e omarchy-working-memory >/dev/null 2>&1 &
disown

# Poll briefly for the window to map AND land on the special workspace,
# then reveal it. (The window rule sends it there silently, so the very
# first launch would otherwise start invisible.)
for _ in $(seq 1 40); do
  if on_special_workspace; then
    reveal
    exit 0
  fi
  sleep 0.05
done
