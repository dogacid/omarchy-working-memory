{
  "manifest_version": 3,
  "name": "Working Memory capture",
  "version": "0.1.0",
  "description": "Send the selection, a link or the page to the omarchy-working-memory inbox.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to the Working Memory inbox"
  },
  "commands": {
    "capture": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Send the selection (or the page) to the Working Memory inbox"
    }
  }
}
